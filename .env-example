# Which Kalshi environment to target. Defaults to "demo" (sandbox) for safety.
# Set to "prod" for real-money trading.
KALSHI_ENV=demo

# Credentials are OPTIONAL: public market/rules tools work without them.
# They are required for portfolio and order (trading) tools.
KALSHI_API_KEY=<your Kalshi API key ID>
KALSHI_PRIVATE_KEY_PATH=<path to your Kalshi RSA private key .pem file>

# Optional: explicitly override the REST base URL (must include /trade-api/v2).
# Leave unset to derive it from KALSHI_ENV.
# BASE_URL=https://demo-api.kalshi.co/trade-api/v2
